{
  "entities": {
    "UserSecurityProfile": {
      "title": "UserSecurityProfile",
      "description": "Per-user account security preferences and last verified session metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated Firebase UID."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified Google email address."
        },
        "autoLockMinutes": {
          "type": "integer",
          "description": "Inactivity minutes before clearing in-memory OAuth token (0, 5, 10, 30)."
        },
        "requireReauthForSensitiveActions": {
          "type": "boolean",
          "description": "Whether sensitive account actions require fresh Google re-authentication."
        },
        "lastVerifiedDevice": {
          "type": "string",
          "enum": ["tablet", "mobile", "desktop"],
          "maxLength": 20,
          "description": "Device category of last verified sign-in."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when security profile was initialized."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when security profile was last updated."
        }
      },
      "required": [
        "uid",
        "email",
        "autoLockMinutes",
        "requireReauthForSensitiveActions",
        "lastVerifiedDevice",
        "createdAt",
        "updatedAt"
      ]
    },
    "SecurityLog": {
      "title": "SecurityLog",
      "description": "Append-only, tamper-evident security activity log for account protection.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated Firebase UID of the account owner."
        },
        "eventType": {
          "type": "string",
          "enum": [
            "sign_in",
            "reauth_verified",
            "gmail_send",
            "admin_mail",
            "token_revoked",
            "settings_updated",
            "world_cloud_save",
            "world_cloud_delete"
          ],
          "maxLength": 32,
          "description": "Type of security event."
        },
        "deviceType": {
          "type": "string",
          "enum": ["tablet", "mobile", "desktop"],
          "maxLength": 20,
          "description": "Device category from which the action occurred."
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Short non-sensitive event summary."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when event occurred."
        }
      },
      "required": [
        "uid",
        "eventType",
        "deviceType",
        "detail",
        "createdAt"
      ]
    },
    "WorldSave": {
      "title": "WorldSave",
      "description": "Authenticated user's voxel world save stored securely in Firestore.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique world document identifier."
        },
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "version": {
          "type": "integer",
          "description": "Save format schema version."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Player-chosen world title."
        },
        "gameMode": {
          "type": "string",
          "enum": ["survival", "creative"],
          "maxLength": 20,
          "description": "Active game mode."
        },
        "difficulty": {
          "type": "string",
          "enum": ["peaceful", "easy", "normal", "hard"],
          "maxLength": 20,
          "description": "World difficulty level."
        },
        "worldType": {
          "type": "string",
          "enum": ["default", "flat", "mountains", "heaven", "fusion"],
          "maxLength": 20,
          "description": "World generator type."
        },
        "seed": {
          "type": "integer",
          "description": "Terrain generation seed."
        },
        "timeOfDay": {
          "type": "number",
          "description": "Normalized time of day (0.0 to 1.0)."
        },
        "weather": {
          "type": "string",
          "enum": ["clear", "rain", "thunder"],
          "maxLength": 20,
          "description": "Current weather state."
        },
        "player": {
          "type": "object",
          "description": "Player position, orientation, stats, and 36-slot inventory."
        },
        "modifiedBlocks": {
          "type": "object",
          "description": "Map of coordinate keys ('x,y,z') to BlockType strings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when world cloud save was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when world cloud save was last updated."
        }
      },
      "required": [
        "id",
        "uid",
        "version",
        "name",
        "gameMode",
        "difficulty",
        "worldType",
        "seed",
        "timeOfDay",
        "weather",
        "player",
        "modifiedBlocks",
        "createdAt",
        "updatedAt"
      ]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Player-submitted feedback, suggestions, or bug reports directed to admin ruiqishi59@gmail.com.",
      "type": "object",
      "properties": {
        "senderUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated Firebase UID of the player submitting feedback."
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Display name of the sender."
        },
        "senderEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified email address of the sender."
        },
        "category": {
          "type": "string",
          "enum": ["suggestion", "bug", "balance", "other"],
          "maxLength": 20,
          "description": "Feedback category."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Feedback subject line."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Detailed feedback content."
        },
        "deviceType": {
          "type": "string",
          "enum": ["tablet", "mobile", "desktop"],
          "maxLength": 20,
          "description": "Device category from which the player sent the feedback."
        },
        "emailedToAdmin": {
          "type": "boolean",
          "description": "Whether an email copy was sent to ruiqishi59@gmail.com."
        },
        "status": {
          "type": "string",
          "enum": ["unread", "read", "replied"],
          "maxLength": 20,
          "description": "Admin review status."
        },
        "adminReply": {
          "type": "string",
          "maxLength": 2000,
          "description": "Reply text written by admin ruiqishi59@gmail.com."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when feedback was submitted."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when feedback was last updated."
        }
      },
      "required": [
        "senderUid",
        "senderName",
        "senderEmail",
        "category",
        "subject",
        "message",
        "deviceType",
        "emailedToAdmin",
        "status",
        "adminReply",
        "createdAt",
        "updatedAt"
      ]
    },
    "MailboxMessage": {
      "title": "MailboxMessage",
      "description": "In-game mailbox messages and announcements sent exclusively by admin ruiqishi59@gmail.com.",
      "type": "object",
      "properties": {
        "recipientType": {
          "type": "string",
          "enum": ["direct", "broadcast"],
          "maxLength": 20,
          "description": "Whether the message targets a specific player or all players."
        },
        "recipientUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$",
          "description": "Target user UID (or 'ALL' for broadcasts, or empty string if addressed by email)."
        },
        "recipientEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Target user email (or 'ALL' for broadcasts)."
        },
        "senderEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified admin email (ruiqishi59@gmail.com)."
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Sender display name."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Mailbox message title."
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Mailbox message content."
        },
        "type": {
          "type": "string",
          "enum": ["system", "reply", "direct", "reward"],
          "maxLength": 20,
          "description": "Message classification."
        },
        "relatedFeedbackId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$",
          "description": "Optional related feedback document ID."
        },
        "isRead": {
          "type": "boolean",
          "description": "Read flag for direct messages."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when mailbox message was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when mailbox message was last updated."
        }
      },
      "required": [
        "recipientType",
        "recipientUid",
        "recipientEmail",
        "senderEmail",
        "senderName",
        "title",
        "body",
        "type",
        "relatedFeedbackId",
        "isRead",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserSecurityProfile"
      },
      "description": "Per-user security profile & session protection preferences; strictly owner-only access with Google Sign-In."
    },
    "/users/{userId}/security_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/SecurityLog"
      },
      "description": "Append-only tamper-evident account security activity log; strictly owner-only read/create, never update/delete."
    },
    "/users/{userId}/worlds/{worldId}": {
      "schema": {
        "$ref": "#/entities/WorldSave"
      },
      "description": "Authenticated user's personal voxel world saves; strictly owner-only read/write via verified Google Sign-In."
    },
    "/feedbacks/{feedbackId}": {
      "schema": {
        "$ref": "#/entities/Feedback"
      },
      "description": "Player feedback submissions, readable by the author or admin (ruiqishi59@gmail.com) and manageable exclusively by admin."
    },
    "/mailbox/{messageId}": {
      "schema": {
        "$ref": "#/entities/MailboxMessage"
      },
      "description": "In-game mailbox messages and broadcasts; only admin (ruiqishi59@gmail.com) can compose/send messages."
    }
  }
}
