rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------
    // Global Hardened Primitives
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'ruiqishi59@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOptionalId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]*$');
    }

    // ------------------------------------------------------------
    // Entity Validation Blueprints
    // ------------------------------------------------------------
    function isValidFeedback(data) {
      return data.keys().hasAll([
        'senderUid',
        'senderName',
        'senderEmail',
        'category',
        'subject',
        'message',
        'deviceType',
        'emailedToAdmin',
        'status',
        'adminReply',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'senderUid',
        'senderName',
        'senderEmail',
        'category',
        'subject',
        'message',
        'deviceType',
        'emailedToAdmin',
        'status',
        'adminReply',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.senderUid) &&
      data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 64 &&
      data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 160 &&
      data.category in ['suggestion', 'bug', 'balance', 'other'] &&
      data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120 &&
      data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
      data.deviceType in ['tablet', 'mobile', 'desktop'] &&
      data.emailedToAdmin is bool &&
      data.status in ['unread', 'read', 'replied'] &&
      data.adminReply is string && data.adminReply.size() <= 2000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidMailboxMessage(data) {
      return data.keys().hasAll([
        'recipientType',
        'recipientUid',
        'recipientEmail',
        'senderEmail',
        'senderName',
        'title',
        'body',
        'type',
        'relatedFeedbackId',
        'isRead',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'recipientType',
        'recipientUid',
        'recipientEmail',
        'senderEmail',
        'senderName',
        'title',
        'body',
        'type',
        'relatedFeedbackId',
        'isRead',
        'createdAt',
        'updatedAt'
      ]) &&
      data.recipientType in ['direct', 'broadcast'] &&
      isValidOptionalId(data.recipientUid) &&
      data.recipientEmail is string && data.recipientEmail.size() >= 3 && data.recipientEmail.size() <= 160 &&
      data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 160 &&
      data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 64 &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
      data.type in ['system', 'reply', 'direct', 'reward'] &&
      isValidOptionalId(data.relatedFeedbackId) &&
      data.isRead is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // ------------------------------------------------------------
    // Collection: /feedbacks/{feedbackId}
    // ------------------------------------------------------------
    match /feedbacks/{feedbackId} {
      // PII isolated: only author or verified admin (ruiqishi59@gmail.com)
      allow get: if isValidId(feedbackId) && (
        isAdmin() ||
        (isVerified() && existing().senderUid == request.auth.uid)
      );

      allow list: if isAdmin() || (
        isVerified() && resource.data.senderUid == request.auth.uid
      );

      allow create: if isVerified() &&
        isValidId(feedbackId) &&
        isValidFeedback(incoming()) &&
        incoming().senderUid == request.auth.uid &&
        incoming().senderEmail == request.auth.token.email &&
        incoming().status == 'unread' &&
        incoming().adminReply == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // Admin action-based update (mark read or reply) with immutable sender/content
      allow update: if isAdmin() &&
        isValidId(feedbackId) &&
        isValidFeedback(incoming()) &&
        incoming().senderUid == existing().senderUid &&
        incoming().senderEmail == existing().senderEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'updatedAt']);

      allow delete: if isValidId(feedbackId) && (
        isAdmin() ||
        (isVerified() && existing().senderUid == request.auth.uid)
      );
    }

    // ------------------------------------------------------------
    // Collection: /mailbox/{messageId}
    // Exclusive send/create permission reserved for ruiqishi59@gmail.com
    // ------------------------------------------------------------
    match /mailbox/{messageId} {
      allow get: if isValidId(messageId) && (
        isAdmin() ||
        (isVerified() && (
          existing().recipientType == 'broadcast' ||
          existing().recipientUid == request.auth.uid ||
          existing().recipientEmail == request.auth.token.email
        ))
      );

      allow list: if isAdmin() || (
        isVerified() && (
          resource.data.recipientType == 'broadcast' ||
          resource.data.recipientUid == request.auth.uid ||
          resource.data.recipientEmail == request.auth.token.email
        )
      );

      // Only ruiqishi59@gmail.com can send/create messages to any player's mailbox
      allow create: if isAdmin() &&
        isValidId(messageId) &&
        isValidMailboxMessage(incoming()) &&
        incoming().senderEmail == 'ruiqishi59@gmail.com' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(messageId) &&
        isValidMailboxMessage(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().senderEmail == existing().senderEmail &&
        incoming().recipientType == existing().recipientType &&
        incoming().recipientUid == existing().recipientUid &&
        incoming().recipientEmail == existing().recipientEmail &&
        incoming().updatedAt == request.time && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'isRead', 'updatedAt'])) ||
          (existing().recipientType == 'direct' &&
            (existing().recipientUid == request.auth.uid || existing().recipientEmail == request.auth.token.email) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']))
        );

      allow delete: if isValidId(messageId) && (
        isAdmin() ||
        (isVerified() &&
          existing().recipientType == 'direct' &&
          (existing().recipientUid == request.auth.uid || existing().recipientEmail == request.auth.token.email))
      );
    }
  }
}
